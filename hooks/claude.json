{
  "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "~/.local/bin/sleeplock acquire" }] }],
  "Stop":             [{ "hooks": [{ "type": "command", "command": "~/.local/bin/sleeplock release" }] }],
  "SessionEnd":       [{ "hooks": [{ "type": "command", "command": "~/.local/bin/sleeplock release" }] }],
  "Notification":     [{ "matcher": "idle_prompt", "hooks": [{ "type": "command", "command": "~/.local/bin/sleeplock release" }] }]
}
